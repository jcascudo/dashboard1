# Copy to .env.local for local `vercel dev`, and set the same names in Vercel > Settings > Environment Variables.
# Never commit real values. These are secrets.

# Web app URL from Apps Script > Deploy (ends in /exec)
APPS_SCRIPT_URL=

# Same value as the SECRET script property in the Apps Script project
APPS_SCRIPT_SECRET=

# Passcode approvers must enter to approve/reject. The update endpoint refuses all requests if this is unset.
APPROVER_PASSCODE=
